<Window x:Class="BrennorsCall.Launcher.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Brennor's Call Launcher" Width="1150" Height="840" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#0D1316" Foreground="#E8E7DD" FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="28,20,28,20">
    <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><StackPanel><TextBlock Text="B R E N N O R ' S   C A L L" FontFamily="Georgia" FontSize="23" Foreground="{StaticResource Gold}"/><TextBlock Text="THE WAYFARER'S GATE  /  WINDOWS LAUNCHER" FontSize="10" Foreground="#899D96" Margin="1,8,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding ServerStatus}" HorizontalAlignment="Right" Foreground="#A8C5AB"/><TextBlock Text="{Binding VersionLabel}" FontSize="12" Foreground="#98A9A2" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid>
    <TabControl Grid.Row="1" SelectedIndex="{Binding TabIndex}">
      <TabItem Header="PLAY">
        <Grid Margin="0,20,0,12">
          <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border CornerRadius="6" ClipToBounds="True" BorderThickness="1" BorderBrush="#3C4D45">
            <Grid>
              <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#253B3C"/><GradientStop Color="#112024" Offset="0.6"/><GradientStop Color="#080F13" Offset="1"/></LinearGradientBrush></Grid.Background>
              <Viewbox Stretch="Fill" Opacity="0.65"><Canvas Width="1080" Height="230"><Ellipse Width="108" Height="108" Canvas.Left="785" Canvas.Top="-20" Fill="#A6B9A0" Opacity="0.2"/><Path Fill="#354E4C" Data="M430,230 L600,38 687,128 790,59 980,230 Z"/><Path Fill="#192D2D" Data="M330,230 L600,108 720,180 875,80 1080,195 1080,230 Z"/><Path Fill="#0B191B" Data="M0,230 L0,180 240,200 400,165 640,221 810,160 1080,202 1080,230 Z"/><Path Fill="#081316" Data="M850,230 L868,150 856,150 883,83 906,150 895,150 914,230 Z M965,230 L987,153 975,153 1004,65 1035,153 1021,153 1045,230 Z M715,230 L730,183 722,183 742,130 764,183 756,183 770,230 Z"/><Path Stroke="#AC9566" StrokeThickness="3" Fill="#263533" Data="M804,230 L809,173 816,162 822,173 828,230 Z"/></Canvas></Viewbox>
              <StackPanel Margin="30,29,30,25" Width="590" HorizontalAlignment="Left"><TextBlock Text="GREENREACH AWAITS" FontSize="11" Foreground="#D3B47A"/><TextBlock Text="Answer the call." FontFamily="Georgia" FontSize="39" Margin="0,13,0,12"/><TextBlock Text="Forge your own path through a living realm. Your next journey begins at the waystone." Foreground="#AFBEB7" FontSize="15" Width="420" HorizontalAlignment="Left"/></StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Background="#121E20" BorderBrush="#2E3F3B" BorderThickness="1" CornerRadius="5" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="FROM THE WAYSTONE" Foreground="{StaticResource Gold}" FontSize="11"/><TextBlock Text="{Binding News}" FontSize="16" Margin="0,12,0,15"/><TextBlock Text="PATCH NOTES" Foreground="#859E93" FontSize="11"/><TextBlock Text="{Binding PatchNotes}" Foreground="#BBC6BE" Margin="0,8,0,0"/></StackPanel></ScrollViewer></Border>
            <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="YOUR WAYFARER" Foreground="{StaticResource Gold}" FontSize="11"/><ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Display"/><ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name"/><WrapPanel><Button Content="Manage accounts" Command="{Binding AccountsCommand}"/><Button Content="Refresh" Command="{Binding RefreshAccountCommand}"/></WrapPanel><TextBlock Text="{Binding RunningSummary}" Foreground="#98AEA1" FontSize="12" Margin="0,4,0,0"/></StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#172622" CornerRadius="5" Padding="20,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding Status}" Foreground="#E5D7BA"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,12,0,7" Foreground="#BA9D64" Background="#263A32" BorderThickness="0"/><TextBlock Text="{Binding TransferLabel}" Foreground="#8DA697" FontSize="12"/><WrapPanel Margin="0,8,0,-8"><Button Content="Check updates" Command="{Binding CheckCommand}" Padding="10,5"/><Button Content="Repair" Command="{Binding RepairCommand}" Padding="10,5"/><Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5"/></WrapPanel></StackPanel><Button Grid.Column="1" Content="{Binding PrimaryLabel}" Command="{Binding PrimaryCommand}" Background="#C2A16B" Foreground="#101A17" BorderBrush="#DCC18F" FontSize="23" FontWeight="SemiBold" Margin="0" VerticalAlignment="Stretch"/></Grid></Border>
        </Grid>
      </TabItem>
      <TabItem Header="ACCOUNTS">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,24,0,10" IsEnabled="{Binding Idle}"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,25,0"><TextBlock Text="SAVED ACCOUNTS" Foreground="{StaticResource Gold}"/><ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" DisplayMemberPath="Display" Height="210" Margin="0,12,0,14"/><WrapPanel><Button Content="Sign out" Command="{Binding LogoutCommand}"/><Button Content="Remove saved" Command="{Binding RemoveAccountCommand}"/></WrapPanel><TextBlock Text="Passwords are never saved. Remembered sessions are protected by Windows and expire after two hours." Foreground="#8EA399" FontSize="12" Margin="0,14,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="ENTER THE REALM" FontFamily="Georgia" FontSize="25"/><TextBlock Text="Account" Margin="0,18,0,0"/><TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"/><TextBlock Text="Password"/><PasswordBox x:Name="Password" MaxLength="128"/><WrapPanel><Button Content="Sign in" Click="SignIn"/><Button Content="Create account" Click="Register"/></WrapPanel><CheckBox Content="Remember account session on this computer" IsChecked="{Binding Settings.RememberAccounts}"/><TextBlock Text="Create a character" Margin="0,18,0,0"/><TextBox Text="{Binding CharacterName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"/><Button Content="Create character" Command="{Binding CreateCharacterCommand}" HorizontalAlignment="Left"/><TextBlock Text="RUNNING CLIENTS" Foreground="{StaticResource Gold}" Margin="0,18,0,8"/><ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" DisplayMemberPath="Display" Height="100"/><WrapPanel Margin="0,12,0,0"><Button Content="Close client" Command="{Binding CloseClientCommand}"/><Button Content="End client" Command="{Binding EndClientCommand}"/><Button Content="Refresh clients" Command="{Binding RefreshClientsCommand}"/></WrapPanel></StackPanel></Grid></ScrollViewer>
      </TabItem>
      <TabItem Header="SETTINGS">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,24,0,12" IsEnabled="{Binding Idle}"><TextBlock Text="Make camp." FontFamily="Georgia" FontSize="27" Margin="0,0,0,20"/><TextBlock Text="Game installation directory"/><DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Click="Browse"/><TextBox Text="{Binding Settings.GameDirectory, UpdateSourceTrigger=PropertyChanged}"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Release channel"/><ComboBox ItemsSource="{Binding AvailableChannels}" SelectedItem="{Binding Settings.Channel}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Parallel downloads (1–8)"/><TextBox Text="{Binding Settings.DownloadConcurrency}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Bandwidth KiB/s (0 = unlimited)"/><TextBox Text="{Binding Settings.BandwidthKiB}"/></StackPanel></Grid><TextBlock Text="Preview channels require an account grant. Settings apply after Save; active clients retain their own version and runtime folders." Foreground="#8EA399" FontSize="12"/><WrapPanel><CheckBox Content="Check updates on startup" IsChecked="{Binding Settings.AutomaticUpdates}"/><CheckBox Content="Start launcher with Windows" IsChecked="{Binding Settings.StartWithWindows}"/></WrapPanel><TextBlock Text="CLIENT PREFERENCES" Foreground="{StaticResource Gold}" Margin="0,20,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Width"/><TextBox Text="{Binding Settings.Width}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Height"/><TextBox Text="{Binding Settings.Height}"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><CheckBox Content="Fullscreen" IsChecked="{Binding Settings.Fullscreen}"/><CheckBox Content="Disable sound" IsChecked="{Binding Settings.NoSound}"/></StackPanel></Grid><TextBlock Text="Only the approved display and sound arguments above are passed to the game." Foreground="#8EA399" FontSize="12"/><WrapPanel Margin="0,20,0,0"><Button Content="Save settings" Command="{Binding SaveCommand}"/><Button Content="Open diagnostics" Command="{Binding DiagnosticsCommand}"/><Button Content="Update launcher" Command="{Binding SelfUpdateCommand}"/><Button Content="Clean old game versions" Command="{Binding CleanupCommand}"/></WrapPanel><TextBlock Text="Closing the launcher leaves all game clients running. Each client uses an independent account ticket, character lease, settings, log and temporary folder." Foreground="#8EA399" FontSize="12" Margin="0,16,0,0"/></StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" BorderBrush="#293831" BorderThickness="0,1,0,0" Padding="0,12,0,0"><Grid><TextBlock Text="{Binding Footer}" FontSize="11" Foreground="#7E968A"/><TextBlock Text="A REALM WITHOUT CLASSES. A PATH OF YOUR OWN." FontSize="10" Foreground="#7E968A" HorizontalAlignment="Right"/></Grid></Border>
  </Grid>
</Window>
