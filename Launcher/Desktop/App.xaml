<Application x:Class="BrennorsCall.Launcher.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D3B47A"/>
    <Style TargetType="Window"><Setter Property="Background" Value="#0D1316"/><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="Background" Value="#243330"/><Setter Property="BorderBrush" Value="#435149"/><Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#D3B47A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0C1518"/><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="CaretBrush" Value="#D3B47A"/><Setter Property="BorderBrush" Value="#3A4847"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,10,12"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0C1518"/><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="BorderBrush" Value="#3A4847"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,10,12"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="Margin" Value="0,8,14,10"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,10,12"/><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="Background" Value="#0C1518"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Background="#0C1518" BorderBrush="#3A4847" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="10"><TextBlock Text="⌄" HorizontalAlignment="Right" Foreground="#D3B47A"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="10,8,28,8" IsHitTestVisible="False" VerticalAlignment="Center"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#122021" BorderBrush="#526155" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="Background" Value="#122021"/><Setter Property="Padding" Value="10"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A4A40"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#111D20"/><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="BorderBrush" Value="#30403D"/><Setter Property="Padding" Value="6"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E8E7DD"/><Setter Property="Padding" Value="10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3E4C42"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem"><Setter Property="Foreground" Value="#B7C3BE"/><Setter Property="Padding" Value="24,13"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#D3B47A"/><Setter Property="Foreground" Value="#EAD3A8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
